# ===== 数据库 =====
POSTGRES_USER=multimodal
POSTGRES_PASSWORD=changeme
POSTGRES_DB=multimodal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ===== Elasticsearch =====
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=multimodal

# ===== 后端 =====
SECRET_KEY=your-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# ===== 模型配置（初始默认） =====
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBED_PROVIDER=bge-m3
DEFAULT_EMBED_MODEL=BAAI/BGE-M3
DEFAULT_VISION_EMBED_PROVIDER=clip
DEFAULT_VISION_EMBED_MODEL=openai/clip-vit-base-32
DEFAULT_VISION_LLM_PROVIDER=openai
DEFAULT_VISION_LLM_MODEL=gpt-4o

# ===== 模型 API Keys（加密后存储，此处为初始配置用） =====
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===== 前端 =====
VITE_API_BASE_URL=/api
